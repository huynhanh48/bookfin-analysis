# Copy to .env and fill secrets. Never commit .env.
#
# For production Docker (docker-compose.prod.yml), APP_ENV is forced to production.
# Required before deploy:
#   POSTGRES_PASSWORD, REDIS_PASSWORD, ADMIN_API_KEY
#   OPENROUTER_API_KEY (RAG/agent/news/rerank)
# If RAG_NEWS_ENABLED=true: TAVILY_API_KEY and preferably FIRECRAWL_API_KEY.
# If PDF ingestion is needed: RAG_REMOTE_PARSER_URL.
# Keep embedding model/dimension pairs unchanged after vectors exist.

# ── Application ─────────────────────────────────────────────
APP_NAME=stock-research
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=stock_research
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
# Chạy local (uvicorn trên máy):
DATABASE_URL=postgresql+asyncpg://stock:change-me-local@localhost:5432/stock_research
# Chạy trong Docker Compose (host là tên service postgres):
# DATABASE_URL=postgresql+asyncpg://stock:change-me-local@postgres:5432/stock_research

# ── Redis (tuỳ chọn, bật bằng profile cache) ────────────────
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_URL=redis://admin:change-me-local@localhost:6379/0

# ── BookFin FCData Gateway ──────────────────────────────────
FCDATA_BASE_URL=https://fcdata.bookfin.vn
FCDATA_WS_URL=wss://fcdata.bookfin.vn/ws
FCDATA_TIMEOUT_SECONDS=15
FCDATA_MAX_CONCURRENCY=8
FCDATA_MAX_RETRIES=3
# Gateway hiện không yêu cầu key; để trống.
FCDATA_API_KEY=

# ── Market ──────────────────────────────────────────────────
MARKET_TIMEZONE=Asia/Ho_Chi_Minh
QUOTE_STALE_AFTER_SECONDS=300
BENCHMARK_SYMBOL=VNINDEX
COMPUTE_LOOKBACK=400
BACKFILL_LOOKBACK_DAYS=400

# ── Admin ───────────────────────────────────────────────────
# Bắt buộc phải đặt khi APP_ENV khác development để gọi endpoint thao tác.
ADMIN_API_KEY=

# Multimodal RAG (optional; never changes market indicators)
RAG_ENABLED=false
OPENROUTER_API_KEY=
AGENT_ENABLED=false
AGENT_MODEL=google/gemini-2.5-flash
AGENT_RAG_ENABLED=false
AGENT_NEWS_ENABLED=false
AGENT_CHECKPOINT_ENABLED=true
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_PENDING=20
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
RAG_LLM_MODEL=google/gemini-2.5-flash
RAG_TEXT_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_TEXT_EMBEDDING_DIMENSION=1536
RAG_MULTIMODAL_EMBEDDING_MODEL=mongodb/voyage-multimodal-3.5
RAG_MULTIMODAL_EMBEDDING_DIMENSION=1024
RAG_CASE_MULTIMODAL=true
# Tối ưu: false = chỉ index normalized text vào case graph; ảnh vẫn có multimodal embedding.
RAG_CASE_GRAPH_ENABLED=false
RAG_CASE_INDEX_IMAGE=false
RAG_LLM_MAX_ASYNC=4
RAG_EMBEDDING_MAX_ASYNC=4
RAG_MAX_PARALLEL_INSERT=2
RAG_STORAGE_DIR=./data/rag
RAG_UPLOAD_DIR=./data/uploads
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_IMAGE_PIXELS=25000000
RAG_JOB_TIMEOUT_SECONDS=600
# Optional externally hosted MinerU-compatible VLM server; never local inference.
# PDF ingestion is disabled unless supplied. Plain text and chart images need no parser server.
RAG_REMOTE_PARSER_URL=

# Redis ACL credentials (set your own password in .env)
REDIS_USERNAME=admin
REDIS_PASSWORD=change-me-local
RAG_REDIS_MIRROR_ENABLED=false

# Optional dedicated vision model; otherwise uses RAG_LLM_MODEL.
RAG_VISION_MODEL=

# Process-global TA-Lib unstable periods; changing this requires restart and recompute.
INDICATOR_UNSTABLE_PERIODS={}

# ── Evidence enrichment / news / rerank ────────────────────
# Bật RAG_ENRICHMENT_ENABLED=true để chạy pipeline Vision → claim → technical → news.
# Tin tức: Tavily là search chính (TAVILY_API_KEY bắt buộc khi RAG_NEWS_ENABLED=true).
# Firecrawl là fallback extraction/search (FIRECRAWL_API_KEY nên điền để tăng độ ổn định).
# Rerank dùng OPENROUTER_API_KEY ở trên; chỉ gọi API khi RAG_RERANK_ENABLED=true.
# Không gọi provider thật trước khi cấu hình xong. Không commit .env.
RAG_ENRICHMENT_ENABLED=false
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
RAG_NEWS_ENABLED=false
RAG_NEWS_MAX_SOURCES=5
# RSS/Atom feeds are searched alongside Tavily/Firecrawl (JSON array).
RAG_NEWS_RSS_FEEDS=[]
RAG_NEWS_LOOKBACK_DAYS=30
RAG_NEWS_TIMEOUT_SECONDS=20
RAG_NEWS_MIN_RELEVANCE=0.5
# Cho phép bài có published_at nhưng thiếu modified_time; ghi warning thay vì loại.
RAG_NEWS_ALLOW_UNKNOWN_REVISION=true
# Tìm tin theo cửa sổ hình thành divergence + buffer, không chỉ một ngày.
RAG_NEWS_SIGNAL_WINDOW_ENABLED=true
RAG_NEWS_SIGNAL_BUFFER_DAYS=14
# Cửa sổ xác nhận phân kỳ gần nhất (ngày) để verify claim.
RAG_DIVERGENCE_LOOKBACK_DAYS=60
# Ngưỡng RSI dùng cho contextual evidence, không bắt buộc tại breakout.
RAG_RSI_OVERBOUGHT=70
RAG_RSI_OVERSOLD=30
RAG_PROVIDER_CONCURRENCY=3
RAG_PROVIDER_CACHE_SECONDS=86400
RAG_ENRICHMENT_MAX_ATTEMPTS=3
RAG_FETCH_MISSING_MARKET_DATA=false

# OpenRouter /rerank. Có thể đổi model nếu catalog OpenRouter hỗ trợ.
RAG_RERANK_ENABLED=false
RAG_RERANK_PROVIDER=openrouter
RAG_RERANK_MODEL=mongodb/rerank-2.5-lite
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_N=5
RAG_RERANK_TIMEOUT_SECONDS=10
RAG_RERANK_FAIL_OPEN=true

# JSON array of verified first-party company domains (host only, no https://).
# e.g. ["khangdien.com.vn"]. Do not list news sites here; they are not official.
RAG_NEWS_COMPANY_DOMAINS=[]

# WebSocket foundation (single API process; no producer enabled automatically)
WEBSOCKET_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://analysis.bookfin.vn","https://analysis.bookfin.vn"]
WEBSOCKET_MAX_CONNECTIONS=500
WEBSOCKET_QUEUE_SIZE=100
WEBSOCKET_MAX_SUBSCRIPTIONS=20
WEBSOCKET_MAX_MESSAGE_BYTES=16384
WEBSOCKET_IDLE_SECONDS=60
WEBSOCKET_SEND_TIMEOUT_SECONDS=10

# Chart snapshots: shared per API process, active subscriptions only.
CHART_REALTIME_ENABLED=true
CHART_REALTIME_REFRESH_SECONDS=5
CHART_REALTIME_TICK_SECONDS=2
CHART_REALTIME_CONCURRENCY=4


# Scheduler worker (container `scheduler`, profile workers)
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_START=false
SCHEDULER_POLL_SECONDS=20
SCHEDULER_JOB_TIMEOUT_SECONDS=1800
SCHEDULER_INGEST_CONCURRENCY=4
SCHEDULER_SCAN_LIMIT=600
SCHEDULER_HEARTBEAT_FILE=/tmp/scheduler.heartbeat
# Ngày lễ bỏ qua job, dạng dd/mm/yyyy,dd/mm/yyyy
SCHEDULER_HOLIDAYS=
# Số ngày lịch nạp lại mỗi lần ingest-close
INGEST_INCREMENTAL_DAYS=5

# Worker engine dùng chung cho scheduler/executor/realtime
WORKER_HEARTBEAT_DIR=/tmp/bookfin-workers
WORKER_HEARTBEAT_SECONDS=15
WORKER_SHUTDOWN_GRACE_SECONDS=25
WORKER_IDEMPOTENCY_TTL_SECONDS=172800
# true: Redis lock lỗi thì vẫn chạy job; false: bỏ qua job để tránh chạy trùng
WORKER_LOCK_FAIL_OPEN=true
# Realtime kích hoạt ingest/recompute sau giờ đóng phiên
WORKER_SESSION_CLOSE_TIME=15:00
WORKER_SESSION_CHECK_SECONDS=30
# Watchlist cho role realtime (profile realtime)
REALTIME_WORKER_SYMBOLS=FPT,SSI,HPG,VNM,VIC

# Lần deploy đầu: nạp lịch sử để chart/screener có dữ liệu.
# `all` = toàn bộ mã đang hoạt động (~578); có thể thay bằng danh sách mã
# (FPT,SSI,...) nếu muốn seed nhanh một nhóm nhỏ.
BOOTSTRAP_SYMBOLS=all
BOOTSTRAP_MAX_SYMBOLS=1000
BOOTSTRAP_CONCURRENCY=8
BOOTSTRAP_LOOKBACK_DAYS=1200

# Stock Screener (AFL cash-flow strategy)
SCREENER_ENABLED=true
SCREENER_MAX_SYMBOLS=1000
SCREENER_QUOTE_BATCH_SIZE=50
SCREENER_QUOTE_STALE_SECONDS=60
SCREENER_RESULTS_TTL_SECONDS=86400
# Realtime producer: watchlist | universe | all
SCREENER_REALTIME_ENABLED=true
SCREENER_REALTIME_MODE=watchlist
SCREENER_REALTIME_MAX_SYMBOLS=200
SCREENER_EVAL_INTERVAL_SECONDS=1
SCREENER_RECONCILE_SECONDS=15
SCREENER_PUBLISH_INTERVAL_SECONDS=1
SCREENER_EVENT_COOLDOWN_SECONDS=5
SCREENER_MAX_EVENTS_PER_SECOND=20

# Docker production compose (docker-compose.prod.yml)
WEB_PORT=8080
API_PORT=8000
IMAGE_TAG=v1.1.0

# Production Docker entrypoint / image tag (read by docker-compose.prod.yml)
# WEB_PORT is the public Nginx port; API/Postgres/Redis bind to 127.0.0.1.
# WEB_PORT=8080
# API_PORT=8000
# IMAGE_TAG=v1.1.0
