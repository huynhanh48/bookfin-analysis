# ── Application ─────────────────────────────────────────────
APP_NAME=stock-research
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=stock_research
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
# Chạy local (uvicorn trên máy):
DATABASE_URL=postgresql+asyncpg://stock:change-me-local@localhost:5432/stock_research
# Chạy trong Docker Compose (host là tên service postgres):
# DATABASE_URL=postgresql+asyncpg://stock:change-me-local@postgres:5432/stock_research

# ── Redis (tuỳ chọn, bật bằng profile cache) ────────────────
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── BookFin FCData Gateway ──────────────────────────────────
FCDATA_BASE_URL=https://fcdata.bookfin.vn
FCDATA_WS_URL=wss://fcdata.bookfin.vn/ws
FCDATA_TIMEOUT_SECONDS=15
FCDATA_MAX_CONCURRENCY=8
FCDATA_MAX_RETRIES=3
# Gateway hiện không yêu cầu key; để trống.
FCDATA_API_KEY=

# ── Market ──────────────────────────────────────────────────
MARKET_TIMEZONE=Asia/Ho_Chi_Minh
QUOTE_STALE_AFTER_SECONDS=300
BENCHMARK_SYMBOL=VNINDEX
COMPUTE_LOOKBACK=400
BACKFILL_LOOKBACK_DAYS=400

# ── Admin ───────────────────────────────────────────────────
# Bắt buộc phải đặt khi APP_ENV khác development để gọi endpoint thao tác.
ADMIN_API_KEY=
